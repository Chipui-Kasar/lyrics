# MongoDB connection string for standard user
MONGODB_URI=

# MongoDB connection string for admin privileges
MONGODB_ADMIN_URI=

# Credentials for admin login via NextAuth credentials provider
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Base URL for your running application (used for API requests and SEO)
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL to a JSON manifest for the Tangkhul Keyboard download page, e.g.
# { "apkUrl": "...", "version": "1.0.0", "updatedAt": "2026-08-02" }
# Host this file anywhere (GitHub raw, Gist, your own server) and edit it there
# whenever a new APK build ships - the page re-fetches it, no redeploy needed.
NEXT_PUBLIC_TANGKHUL_KEYBOARD_MANIFEST_URL=

CLOUDINARY_CLOUD_NAME=tangkhullyrics
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
